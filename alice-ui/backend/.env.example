# OpenAI API key for server-side API requests
OPENAI_API_KEY=sk-...

# Required: model used by the model response endpoint
OPENAI_MODEL=gpt-5-mini

# Required: Realtime model used by the browser WebRTC voice agent
OPENAI_REALTIME_MODEL=gpt-realtime

# Optional: active AI provider adapter for server-side realtime credentials
AI_PROVIDER=openai

# Optional: Realtime output voice for the browser WebRTC voice agent
OPENAI_REALTIME_VOICE=marin

# Optional: custom OpenAI API base URL
OPENAI_API_BASE=https://api.openai.com

# Optional: model response endpoint port for local development
MODEL_API_PORT=3001

# Optional: secret used by frontend to authenticate to this endpoint
REALTIME_TOKEN_ENDPOINT_SECRET=your-secret

# Optional: backend port for local development
PORT=3000
