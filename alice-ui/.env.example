# Frontend Vite configuration
VITE_REALTIME_TOKEN_ENDPOINT=http://localhost:3000/api/realtime-token
VITE_OPENAI_REALTIME_TOKEN_ENDPOINT=http://localhost:3000/api/realtime-token
VITE_OPENAI_REALTIME_MODEL=gpt-realtime
VITE_OPENAI_API_BASE=https://api.openai.com

# Set to true while testing the UI without calling OpenAI or requesting microphone access.
VITE_MOCK_REALTIME_DISCOVERY=false

# Optional: frontend-only OpenAI API key for direct OpenAI calls if needed
# VITE_OPENAI_API_KEY=sk-...

# Backend configuration (loaded from backend/.env when running backend/openaiRealtimeTokenEndpoint.ts)
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com
# REALTIME_TOKEN_ENDPOINT_SECRET=your-secret
# PORT=3000
